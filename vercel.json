{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "devhub-workspace": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app/main.py"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "devhub-workspace"
      }
    }
  ]
}
